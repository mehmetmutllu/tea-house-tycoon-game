<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/yedek_kurallari"
        android:fullBackupContent="@xml/yedek_eski"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            EKRAN YÖNÜ — K0 SERBEST (D-132). Kullanıcının kararı: "ana tema dikey ama yatayda da
            kullanılabilir olmalı; kullanıcı isterse yataya dönebilir veya tablette oynarsa
            yatay gibi tepki verecek". Yani kilit YOK, dört yön de açık.

            NEDEN YAZILI: bugüne dek burada hiçbir beyan yoktu ve davranış Android'in
            `unspecified` varsayılanına bırakılmıştı. Karar o varsayılanla aynı sonucu verse de
            YAZISIZDI — bu projenin iki kez yandığı kalıp tam olarak odur (ölü/yazısız kural
            sessizce çürür, D-131). Beyan edilince bekçi de denetleyebiliyor.

            NEDEN `fullUser`, `fullSensor` DEĞİL: ikisi de dört yöne izin verir, ama `fullSensor`
            cihazın kendi döndürme KİLİDİNİ ezer — kullanıcı ekranı kilitlemişken bile döner.
            Kullanıcının cümlesi "kullanıcı İSTERSE yataya dönebilir"di; `fullUser` tam olarak
            budur: yönü kullanıcı belirler, uygulama dayatmaz.

            `configChanges` içindeki `orientation|screenSize` KALDIRILMAMALI: onlar olmadan
            döndürme Activity'yi yeniden kurar, WebView baştan yüklenir ve oturum sıfırlanır.
            Ölçümde oyun durumunun korunmasının (wallet/tables/npc birebir) sebebi budur.
        -->
        <activity
            android:screenOrientation="fullUser"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            REKLAM (F3 · D-144). GERÇEK AdMob Android uygulama kimliği (mutlubadem.dev, 2026-10-04).
            Birimler `src/config/ads.config.ts`'te; geliştirme/test derlemesi test birimlerini kullanır.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9532352817217002~7822557727" />

        <!-- PLAY GAMES (F4b · D-153). Değer strings.xml'de; boşken eklenti SDK'yı hiç kurmaz. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <!-- ANALİTİK (1.0.7 · D-178): Firebase yalnız oyun istatistiği toplar — reklam kimliği ve reklam
             sinyalleri ilk olaydan önce KAPALI (izleme yok; gizlilik politikası ve mağaza beyanı buna dayanır). -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Reklam kimliği (AD_ID) ve Privacy Sandbox izinlerini reklam SDK'sı kendisi ekler; burada
        ÇIKARILMAZ (D-151: SDK tarafında kısıt yok, içerik AdMob panelinden yönetiliyor).
    -->
</manifest>
